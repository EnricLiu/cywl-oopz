# OOPZ credentials. Obtain these through the SDK-supported login flow; never commit real values.
OOPZ_DEVICE_ID=
OOPZ_PERSON_UID=
OOPZ_JWT_TOKEN=
# Optional: omit to use the SDK's built-in signing-key fallback.
OOPZ_PRIVATE_KEY=

# Bot behaviour
CYWL_COMMAND_PREFIX=!

# PostgreSQL. Real connection details stay in your ignored .env file.
# Example: postgresql+asyncpg://cywl:change-me@127.0.0.1:5432/cywl_oopz
DATABASE_URL=
CYWL_DB_POOL_SIZE=5
CYWL_DB_MAX_OVERFLOW=10
CYWL_DB_POOL_TIMEOUT_SECONDS=30
CYWL_DB_POOL_RECYCLE_SECONDS=1800

# LLM text chat. Set CYWL_CHAT_ENABLED=true only after filling all provider settings.
CYWL_CHAT_ENABLED=false
CYWL_LLM_BASE_URL=https://api.openai.com/v1
CYWL_LLM_API_KEY=
CYWL_LLM_MODEL=
# Optional system prompt; the application has a concise Chinese default.
CYWL_LLM_SYSTEM_PROMPT=
# Optional comma-separated allow-list. Defaults to CYWL_LLM_MODEL.
CYWL_LLM_ALLOWED_MODELS=
# OOPZ person IDs permitted to change models with !model <name>.
CYWL_CHAT_MODEL_SELECTION_USERS=
CYWL_LLM_TIMEOUT_SECONDS=30
CYWL_LLM_STREAM=true
CYWL_CHAT_SESSION_TTL_SECONDS=86400
CYWL_CHAT_MAX_HISTORY_MESSAGES=12
CYWL_CHAT_MAX_HISTORY_CHARACTERS=12000
CYWL_CHAT_USER_COOLDOWN_SECONDS=1
CYWL_CHAT_MAX_GLOBAL_CONCURRENCY=8
CYWL_CHAT_MAX_CHANNEL_CONCURRENCY=2
CYWL_CHAT_MAX_USER_CONCURRENCY=1

# AI Agent text-chat route. Provider/model credentials are maintained in PostgreSQL.
CYWL_AGENT_MODE=legacy
CYWL_AGENT_SYSTEM_PROMPT=
CYWL_AGENT_SESSION_TTL_SECONDS=86400
CYWL_AGENT_MAX_HISTORY_MESSAGES=20
CYWL_AGENT_MAX_HISTORY_CHARACTERS=20000
CYWL_AGENT_TIMEOUT_SECONDS=45
CYWL_AGENT_MAX_MODEL_REQUESTS=6
CYWL_AGENT_MAX_TOOL_CALLS=8
CYWL_AGENT_MAX_TOTAL_TOKENS=32000
CYWL_AGENT_MAX_PARALLEL_TOOLS=3
# Application allow-list; channel rows apply a second intersection.
CYWL_AGENT_ENABLED_TOOLS=get_agent_status,get_channel_settings,react_to_message
CYWL_AGENT_TOOL_TIMEOUT_SECONDS=10
CYWL_AGENT_MAX_TOOL_RESULT_CHARACTERS=32768
CYWL_AGENT_SUMMARY_ENABLED=true
CYWL_AGENT_SUMMARY_TRIGGER_MESSAGES=24
CYWL_AGENT_SUMMARY_RETAIN_MESSAGES=12
CYWL_AGENT_SUMMARY_TIMEOUT_SECONDS=20
CYWL_AGENT_SUMMARY_MAX_CHARACTERS=4000
CYWL_AGENT_MEMORY_ENABLED_BY_DEFAULT=true
CYWL_AGENT_MEMORY_DEFAULT_TTL_DAYS=180
CYWL_AGENT_MEMORY_MAX_ITEMS=20
CYWL_AGENT_MEMORY_CONTEXT_ITEMS=6
CYWL_AGENT_MEMORY_MAX_ITEM_CHARACTERS=1000
CYWL_AGENT_STALE_RUN_AFTER_SECONDS=90
